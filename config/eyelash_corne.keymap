#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25    // 10

#define BASE 0
#define EXT  1
#define NUM  2
#define SYM  3
#define FUN  4

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener {
    input-processors = <&zip_xy_scaler 2 1>;
};

&msc_input_listener {
    input-processors = <&zip_scroll_scaler 2 1>;
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <2000>;
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * BASE — QWERTY
         *
         *   Q W E R T       Y U I O P
         *   A S D F G       H J K L ;
         *   Z X C V B       N M , . /
         *
         * Thumbs:
         *
         *   Extend | Numbers | Space
         *   Enter  | Symbols | Function
         *
         * All layer switching is tap-based.
         */
        base_layer {
            display-name = "QWERTY";

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T                              &kp UP                 &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
&td0       &kp A  &kp S  &kp D  &kp F  &kp G                    &kp LEFT  &kp ENTER  &kp RIGHT  &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &kp B        &kp SPACE             &kp DOWN               &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                              &to EXT  &to NUM  &kp SPACE                                                &kp ENTER  &to SYM  &to FUN
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /*
         * EXTEND
         *
         * Left:
         *   browser/navigation shortcuts
         *   sticky Alt, GUI, Shift, Ctrl and AltGr
         *   Undo, Cut, Copy, GUI and Paste
         *
         * Right:
         *   page movement, arrows, editing and utility keys
         */
        extend_layer {
            display-name = "EXTEND";

            bindings = <
&trans  &kp ESC      &kp LA(LEFT)  &kp LC(F)  &kp LA(RIGHT)  &kp INS                                  &mmv MOVE_UP                     &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp CAPS     &trans
&trans  &sk LALT     &sk LGUI      &sk LSHFT  &sk LCTRL      &sk RALT                     &mmv MOVE_LEFT  &to BASE  &mmv MOVE_RIGHT  &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL      &trans
&trans  &kp LC(Z)    &kp LC(X)     &kp LC(C)   &kp LGUI       &kp LC(V)       &mkp LCLK                    &mmv MOVE_DOWN                   &kp ENTER  &kp BSPC  &kp TAB   &kp K_CMENU  &kp PSCRN  &trans
                                             &to BASE       &to NUM          &kp SPACE                                                               &kp ENTER  &to SYM   &to FUN
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /*
         * NUMBERS
         *
         * Right-hand numpad:
         *
         *   =  7 8 9 +
         *   *  4 5 6 -
         *   0  1 2 3 /
         *
         * Sticky modifiers remain on the left home row.
         */
        numbers_layer {
            display-name = "NUMBERS";

            bindings = <
&trans  &none       &none          &none        &none          &kp KP_NLCK                              &mmv MOVE_UP                     &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp PLUS   &trans
&trans  &sk LALT    &sk LGUI       &sk LSHFT    &sk LCTRL      &sk RALT                    &mmv MOVE_LEFT  &to BASE  &mmv MOVE_RIGHT  &kp ASTRK  &kp N4  &kp N5  &kp N6  &kp MINUS  &trans
&trans  &none       &kp K_CMENU    &kp INS      &kp BSPC       &kp ENTER      &mkp LCLK                    &mmv MOVE_DOWN                   &kp N0     &kp N1  &kp N2  &kp N3  &kp FSLH   &trans
                                           &to EXT         &to BASE       &kp SPACE                                                               &kp ENTER  &to SYM  &to FUN
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /*
         * SYMBOLS
         *
         *   ! @ # $ %       = ` : ; +
         *   sticky mods     * ( { [ -
         *       \ | &       ~ ) } ] _
         */
        symbols_layer {
            display-name = "SYMBOLS";

            bindings = <
&trans  &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT                              &mmv MOVE_UP                     &kp EQUAL  &kp GRAVE  &kp COLON  &kp SEMI  &kp PLUS   &trans
&trans  &sk LALT    &sk LGUI    &sk LSHFT   &sk LCTRL   &sk RALT                  &mmv MOVE_LEFT  &to BASE  &mmv MOVE_RIGHT  &kp ASTRK  &kp LPAR   &kp LBRC   &kp LBKT  &kp MINUS  &trans
&trans  &none       &none       &kp BSLH    &kp PIPE    &kp AMPS     &mkp LCLK                    &mmv MOVE_DOWN                   &kp TILDE  &kp RPAR   &kp RBRC   &kp RBKT  &kp UNDER  &trans
                                      &to EXT        &to NUM      &kp SPACE                                                               &kp ENTER  &to BASE   &to FUN
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /*
         * FUNCTION
         *
         * Seniply-style media controls and numpad-shaped F-keys.
         *
         * Additional keyboard controls use the outer columns and
         * centre cluster:
         *
         * - Studio unlock
         * - Bluetooth profiles 0–3
         * - Clear selected Bluetooth profile
         * - USB/Bluetooth output
         * - RGB toggle, effect and brightness
         *
         * BT_CLR_ALL and settings_reset are intentionally absent.
         */
        function_layer {
            display-name = "FUNCTION";

            bindings = <
&studio_unlock     &kp C_STOP    &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp C_BRI_DN                              &bt BT_SEL 0                    &kp F12  &kp F7  &kp F8  &kp F9  &kp SLCK   &out OUT_USB
&rgb_ug RGB_TOG    &sk LALT      &sk LGUI        &sk LSHFT       &sk LCTRL       &sk RALT                      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp F11  &kp F4  &kp F5  &kp F6  &kp PSCRN  &out OUT_BLE
&bt BT_CLR         &kp C_MUTE    &kp C_VOL_DN    &kp LS(LC(C))   &kp C_VOL_UP    &kp LS(LC(V))  &rgb_ug RGB_BRI              &rgb_ug RGB_BRD                 &kp F10  &kp F1  &kp F2  &kp F3  &to BASE  &rgb_ug RGB_EFF
                                                   &to EXT          &to NUM        &kp SPACE                                                                  &kp ENTER  &to SYM  &to BASE
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
