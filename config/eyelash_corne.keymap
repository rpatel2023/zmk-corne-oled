#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25    // 10

#define BASE 0
#define NAV  1
#define NUM  2
#define SYM  3
#define FUN  4

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener {
    input-processors = <&zip_xy_scaler 2 1>;
};

&msc_input_listener {
    input-processors = <&zip_scroll_scaler 2 1>;
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <2000>;
};

/ {
    behaviors {
        /*
         * Timeless-style home-row modifiers.
         *
         * Left:
         *   A = GUI, S = Alt, D = Ctrl, F = Shift
         *
         * Right:
         *   J = Shift, K = Ctrl, L = Alt, ; = GUI
         *
         * Opposite-hand positional filtering reduces accidental
         * modifier activation during normal same-hand typing rolls.
         */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                6 7 8 9 10 11 12
                19 20 21 22 23 24 25 26 27
                34 35 36 37 38 39 40 41
                45 46 47
            >;

            hold-trigger-on-release;
            display-name = "Left Home Row Mod";
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                0 1 2 3 4 5 6
                13 14 15 16 17 18 19 20 21
                28 29 30 31 32 33 34 35
                42 43 44
            >;

            hold-trigger-on-release;
            display-name = "Right Home Row Mod";
        };

        /*
         * Quick tap sends a normal key.
         * Hold for 500 ms toggles the selected layer on.
         *
         * Parameter order:
         *   1 = layer
         *   2 = tap key
         */
        thumb_tog: thumb_hold_toggle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            quick-tap-ms = <0>;
            bindings = <&tog>, <&kp>;
            display-name = "Hold Toggle / Tap";
        };

        /*
         * Studio-assignable long-press shortcut behavior.
         *
         * Quick tap sends parameter 2.
         * Hold for 500 ms sends parameter 1.
         *
         * Parameter 1 may be a modified keycode such as
         * Ctrl+Shift+T or GUI+V.
         */
        long_shortcut: long_press_shortcut {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;
            display-name = "Hold Shortcut / Tap";
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * BASE — QWERTY with home-row modifiers
         *
         * Tap:
         *   A S D F       J K L ;
         *
         * Hold:
         *   GUI Alt Ctrl Shift    Shift Ctrl Alt GUI
         *
         * Thumbs:
         *
         *   Esc/Nav | GUI/Num | Space
         *   Enter   | Bspc/Sym | Del/Fun
         *
         * The four dual-role thumbs toggle their layer after a
         * deliberate 500 ms hold. The layer stays active after release.
         */
        base_layer {
            display-name = "QWERTY HRM";

            bindings = <
&kp TAB    &kp Q                 &kp W                 &kp E                    &kp R                  &kp T                                      &kp UP                   &kp Y          &kp U                  &kp I                    &kp O                  &kp P                   &kp BSPC
&td0       &hml LEFT_GUI A       &hml LEFT_ALT S       &hml LEFT_CONTROL D      &hml LEFT_SHIFT F      &kp G                         &kp LEFT  &kp ENTER  &kp RIGHT  &kp H          &hmr RIGHT_SHIFT J      &hmr RIGHT_CONTROL K    &hmr RIGHT_ALT L       &hmr RIGHT_GUI SEMI     &kp SQT
&kp LCTRL  &kp Z                 &kp X                 &kp C                    &kp V                  &kp B        &kp SPACE                        &kp DOWN                 &kp N          &kp M                  &kp COMMA                &kp DOT                &kp FSLH                &kp ESC
                                                       &thumb_tog NAV ESC       &thumb_tog NUM LEFT_GUI  &kp SPACE                                                                &kp ENTER      &thumb_tog SYM BSPC    &thumb_tog FUN DEL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /*
         * NAVIGATION
         *
         * Right hand:
         *
         *   Redo  Paste Copy Cut  Undo
         *   Left  Down  Up   Right Caps
         *   Home  PgDn  PgUp End  Insert
         *
         * Left home row:
         *
         *   GUI Alt Ctrl Shift
         *
         * Tap the left-outer thumb to return to QWERTY.
         */
        navigation_layer {
            display-name = "NAVIGATION";

            bindings = <
&trans  &none          &none          &none             &none            &none                                  &mmv MOVE_UP                     &kp LC(Y)  &kp LC(V)  &kp LC(C)  &kp LC(X)  &kp LC(Z)  &trans
&trans  &kp LEFT_GUI   &kp LEFT_ALT   &kp LEFT_CONTROL  &kp LEFT_SHIFT   &none                     &mmv MOVE_LEFT  &to BASE  &mmv MOVE_RIGHT  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp CAPS   &trans
&trans  &none          &none          &none             &none            &none      &mkp LCLK                      &mmv MOVE_DOWN                   &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp INS    &trans
                                                 &to BASE       &kp LEFT_GUI  &kp SPACE                                                                 &kp ENTER  &kp BSPC  &kp DEL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /*
         * NUMBERS
         *
         * Right-hand numpad:
         *
         *   =  7 8 9 +
         *   *  4 5 6 -
         *   0  1 2 3 /
         *
         * Tap the left-middle thumb to return to QWERTY.
         */
        numbers_layer {
            display-name = "NUMBERS";

            bindings = <
&trans  &none       &none          &none        &none          &kp KP_NLCK                              &mmv MOVE_UP                     &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp PLUS   &trans
&trans  &sk LALT    &sk LGUI       &sk LSHFT    &sk LCTRL      &sk RALT                    &mmv MOVE_LEFT  &to BASE  &mmv MOVE_RIGHT  &kp ASTRK  &kp N4  &kp N5  &kp N6  &kp MINUS  &trans
&trans  &none       &kp K_CMENU    &kp INS      &kp BSPC       &kp ENTER      &mkp LCLK                    &mmv MOVE_DOWN                   &kp N0     &kp N1  &kp N2  &kp N3  &kp FSLH   &trans
                                           &kp ESC         &to BASE       &kp SPACE                                                               &kp ENTER  &kp BSPC  &kp DEL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /*
         * SYMBOLS
         *
         *   ! @ # $ %       = ` : ; +
         *   sticky mods     * ( { [ -
         *       \ | &       ~ ) } ] _
         *
         * Tap the right-middle thumb to return to QWERTY.
         */
        symbols_layer {
            display-name = "SYMBOLS";

            bindings = <
&trans  &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT                              &mmv MOVE_UP                     &kp EQUAL  &kp GRAVE  &kp COLON  &kp SEMI  &kp PLUS   &trans
&trans  &sk LALT    &sk LGUI    &sk LSHFT   &sk LCTRL   &sk RALT                  &mmv MOVE_LEFT  &to BASE  &mmv MOVE_RIGHT  &kp ASTRK  &kp LPAR   &kp LBRC   &kp LBKT  &kp MINUS  &trans
&trans  &none       &none       &kp BSLH    &kp PIPE    &kp AMPS     &mkp LCLK                    &mmv MOVE_DOWN                   &kp TILDE  &kp RPAR   &kp RBRC   &kp RBKT  &kp UNDER  &trans
                                      &kp ESC       &kp LEFT_GUI  &kp SPACE                                                               &kp ENTER  &to BASE   &kp DEL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /*
         * FUNCTION / SYSTEM
         *
         * Contains F-keys, media, Studio unlock, Bluetooth profiles,
         * selected-profile clearing, output selection and RGB controls.
         *
         * BT_CLR_ALL and settings_reset are intentionally absent.
         *
         * Tap the right-outer thumb to return to QWERTY.
         */
        function_layer {
            display-name = "FUNCTION";

            bindings = <
&studio_unlock     &kp C_STOP    &kp C_PREV      &kp C_PP        &kp C_NEXT      &kp C_BRI_DN                              &bt BT_SEL 0                    &kp F12  &kp F7  &kp F8  &kp F9  &kp SLCK   &out OUT_USB
&rgb_ug RGB_TOG    &sk LALT      &sk LGUI        &sk LSHFT       &sk LCTRL       &sk RALT                      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp F11  &kp F4  &kp F5  &kp F6  &kp PSCRN  &out OUT_BLE
&bt BT_CLR         &kp C_MUTE    &kp C_VOL_DN    &kp LS(LC(C))   &kp C_VOL_UP    &kp LS(LC(V))  &rgb_ug RGB_BRI              &rgb_ug RGB_BRD                 &kp F10  &kp F1  &kp F2  &kp F3  &to BASE  &rgb_ug RGB_EFF
                                                   &kp ESC          &kp LEFT_GUI    &kp SPACE                                                                  &kp ENTER  &kp BSPC  &to BASE
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /*
         * Reserved Studio layers 5-15.
         *
         * ZMK Studio can enable, rename and populate these without
         * another firmware flash.
         */
        studio_layer_05 {
            status = "reserved";
        };

        studio_layer_06 {
            status = "reserved";
        };

        studio_layer_07 {
            status = "reserved";
        };

        studio_layer_08 {
            status = "reserved";
        };

        studio_layer_09 {
            status = "reserved";
        };

        studio_layer_10 {
            status = "reserved";
        };

        studio_layer_11 {
            status = "reserved";
        };

        studio_layer_12 {
            status = "reserved";
        };

        studio_layer_13 {
            status = "reserved";
        };

        studio_layer_14 {
            status = "reserved";
        };

        studio_layer_15 {
            status = "reserved";
        };
    };
};
