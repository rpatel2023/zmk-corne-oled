#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25    // 10

#define BASE   0
#define NUMBER 1
#define SYMBOL 2
#define OFFICE 3
#define SYSTEM 4

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener {
    input-processors = <&zip_xy_scaler 2 1>;
};

&msc_input_listener {
    input-processors = <&zip_scroll_scaler 2 1>;
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <2000>;
};

/ {
    behaviors {
        /*
         * Left-hand home-row modifiers:
         *
         * Tap:
         *   A S D F
         *
         * Hold:
         *   GUI Alt Ctrl Shift
         *
         * Opposite-hand filtering prevents ordinary left-hand rolls
         * from becoming accidental modifier shortcuts.
         */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                6 7 8 9 10 11 12
                19 20 21 22 23 24 25 26 27
                34 35 36 37 38 39 40 41
                45 46 47
            >;

            hold-trigger-on-release;
            display-name = "Left Home Row Mod";
        };

        /*
         * Right-hand home-row modifiers:
         *
         * Tap:
         *   J K L ;
         *
         * Hold:
         *   Shift Ctrl Alt GUI
         */
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <
                0 1 2 3 4 5 6
                13 14 15 16 17 18 19 20 21
                28 29 30 31 32 33 34 35
                42 43 44
            >;

            hold-trigger-on-release;
            display-name = "Right Home Row Mod";
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * BASE
         *
         * Five-column QWERTY core:
         *
         * Q W E R T       Y U I O P
         * A S D F G       H J K L ;
         * Z X C V B       N M , . /
         *
         * Home-row modifiers:
         *
         * A = GUI     S = Alt     D = Ctrl    F = Shift
         * J = Shift   K = Ctrl    L = Alt     ; = GUI
         *
         * Thumbs:
         *
         * Esc | Number | Space     Enter | Symbol | Backspace
         */
        default_layer {
            display-name = "QWERTY HRM";

            bindings = <
&kp TAB    &kp Q                 &kp W                 &kp E                    &kp R                  &kp T                                      &kp UP                   &kp Y          &kp U                  &kp I                    &kp O                  &kp P                   &kp BSPC
&td0       &hml LEFT_GUI A       &hml LEFT_ALT S       &hml LEFT_CONTROL D      &hml LEFT_SHIFT F      &kp G                         &kp LEFT  &to OFFICE  &kp RIGHT  &kp H          &hmr RIGHT_SHIFT J      &hmr RIGHT_CONTROL K    &hmr RIGHT_ALT L       &hmr RIGHT_GUI SEMI     &kp SQT
&kp LCTRL  &kp Z                 &kp X                 &kp C                    &kp V                  &kp B        &kp DEL                          &kp DOWN                 &kp N          &kp M                  &kp COMMA                &kp DOT                &kp FSLH                &kp ESC
                                                       &kp ESC                  &to NUMBER             &kp SPACE                                                                           &kp ENTER      &to SYMBOL              &kp BSPC
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /*
         * NUMBER
         *
         * Number-row positions stay on their conventional QWERTY
         * fingers. The rest of the layer passes through to Base.
         *
         * Q W E R T       Y U I O P
         * 1 2 3 4 5       6 7 8 9 0
         *
         * Hold a home-row Shift and press a number for its normal
         * shifted symbol.
         */
        number_layer {
            display-name = "NUMBER ROW";

            bindings = <
&trans  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                         &trans                 &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &trans
&trans  &trans     &trans     &trans     &trans     &trans             &trans  &to OFFICE  &trans  &trans     &trans     &trans     &trans     &trans     &trans
&trans  &trans     &trans     &trans     &trans     &trans  &trans                 &trans                 &trans     &trans     &trans     &trans     &trans     &trans
                                         &kp ESC    &to BASE   &kp SPACE                                                       &kp ENTER   &to SYMBOL  &kp BSPC
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /*
         * SYMBOL
         *
         * Top row mirrors shifted number-row symbols.
         *
         * Home and bottom rows keep paired symbols vertically aligned:
         *
         * `  -  =  [  ]       \  ;  '  ,  .
         * ~  _  +  {  }       |  :  "  <  >
         */
        symbol_layer {
            display-name = "SYMBOL";

            bindings = <
&trans  &kp EXCL    &kp AT       &kp HASH     &kp DLLR     &kp PRCNT                         &trans                 &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR    &kp RPAR    &trans
&trans  &kp GRAVE   &kp MINUS    &kp EQUAL    &kp LBKT     &kp RBKT              &trans  &to OFFICE  &trans  &kp BSLH    &kp SEMI    &kp SQT     &kp COMMA   &kp DOT     &trans
&trans  &kp TILDE   &kp UNDER    &kp PLUS     &kp LBRC     &kp RBRC   &trans                 &trans                 &kp PIPE    &kp COLON   &kp DQT     &kp LT      &kp GT      &trans
                                              &kp ESC      &to NUMBER  &kp SPACE                                                        &kp ENTER   &to BASE    &kp BSPC
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /*
         * OFFICE / NAVIGATION
         *
         * Left top:
         *   Undo, Cut, Copy, Paste, Redo
         *
         * Left home:
         *   GUI, Alt, Ctrl, Shift, Select All
         *
         * Right:
         *   Navigation, document movement and editing
         *
         * Centre key returns to Base.
         * Bottom-right outer key opens System.
         */
        office_layer {
            display-name = "OFFICE NAV";

            bindings = <
&kp ESC    &kp LC(Z)         &kp LC(X)         &kp LC(C)         &kp LC(V)         &kp LC(Y)                              &mmv MOVE_UP                      &kp HOME        &kp PG_DN       &kp PG_UP       &kp END          &kp DEL          &kp BSPC
&kp TAB    &kp LEFT_GUI      &kp LEFT_ALT      &kp LEFT_CONTROL  &kp LEFT_SHIFT    &kp LC(A)                &mmv MOVE_LEFT  &to BASE       &mmv MOVE_RIGHT  &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT        &kp BSPC         &kp ENTER
&kp LCTRL  &kp LC(F)         &kp LC(S)         &kp LC(P)         &kp LC(N)         &kp LC(O)     &mkp LCLK                         &mmv MOVE_DOWN                    &kp LC(LEFT)    &kp LC(RIGHT)   &kp LC(HOME)   &kp LC(END)     &kp INSERT       &to SYSTEM
                                                        &kp ESC          &to NUMBER       &kp SPACE                                                                     &kp ENTER       &to SYMBOL      &kp BSPC
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /*
         * SYSTEM
         *
         * Contains the settings that should not be exposed on normal
         * typing layers:
         *
         * - F1-F12
         * - ZMK Studio unlock
         * - Bluetooth profile selection
         * - Clear selected Bluetooth profile
         * - USB/Bluetooth output selection
         * - RGB controls
         * - Media controls
         *
         * BT_CLR_ALL is deliberately omitted.
         * settings_reset is deliberately omitted.
         * Bootloader/reset keys are deliberately omitted because the
         * physical reset switch remains available.
         */
        system_layer {
            display-name = "SYSTEM";

            bindings = <
&studio_unlock     &kp F1             &kp F2             &kp F3             &kp F4             &kp F5                               &kp C_VOL_UP                    &kp F6             &kp F7             &kp F8             &kp F9             &kp F10            &kp F11
&bt BT_CLR         &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3       &bt BT_SEL 4             &kp C_PREV  &to BASE  &kp C_NEXT  &kp F12            &kp PRINTSCREEN    &kp SCROLLLOCK     &kp PAUSE_BREAK    &out OUT_USB       &out OUT_BLE
&rgb_ug RGB_OFF    &rgb_ug RGB_ON     &rgb_ug RGB_EFF    &rgb_ug RGB_EFR    &rgb_ug RGB_BRI    &rgb_ug RGB_BRD  &kp C_MUTE                       &kp C_VOL_DN                    &rgb_ug RGB_SPI    &rgb_ug RGB_SPD    &kp C_PREV         &kp C_PP           &kp C_NEXT         &to BASE
                                                              &kp ESC             &to NUMBER          &kp SPACE                                                                        &kp ENTER          &to SYMBOL         &kp BSPC
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
